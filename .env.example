# HTTP SERVER
# Development only. In production, NODE_ENV/HOST/PORT are set by ecosystem.config.cjs
NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000

# POSTGRES
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Production with SSL: append ?sslmode=verify-full
DATABASE_URL=postgresql://user:password@localhost:5432/forumapi

# TOKENIZE
ACCESS_TOKEN_KEY=replace_with_a_long_random_string
REFRESH_TOKEN_KEY=replace_with_another_long_random_string
# Access token lifetime (seconds)
ACCESS_TOKEN_AGE=3000
