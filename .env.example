# HTTP SERVER
# Development saja. Di production, NODE_ENV/HOST/PORT diatur lewat ecosystem.config.cjs
NODE_ENV=development
# HOST=127.0.0.1
# PORT=3000

# POSTGRES
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/forumapi?sslmode=require

# TOKENIZE
ACCESS_TOKEN_KEY=isi_dengan_string_acak_yang_panjang
REFRESH_TOKEN_KEY=isi_dengan_string_acak_lain_yang_panjang
# Masa berlaku access token (dalam detik)
ACCESS_TOKEN_AGE=3000